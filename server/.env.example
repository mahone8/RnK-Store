PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# OPTION A — Neon (or any hosted/serverless Postgres)
# Get this from your Neon project dashboard → Connection Details.
# When DATABASE_URL is set, it takes priority and SSL is enabled
# automatically — the PG* vars below are ignored.
# ─────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-xxxx.region.aws.neon.tech/neondb?sslmode=require

# ─────────────────────────────────────────────────────────────
# OPTION B — Local PostgreSQL (used only if DATABASE_URL is not set)
# ─────────────────────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=rnk_store
PGUSER=postgres
PGPASSWORD=postgres

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origins allowed to call the API (comma separated)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174
